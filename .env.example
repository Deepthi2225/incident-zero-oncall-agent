# Copy to .env (gitignored) and fill in; oncall/config.py loads it automatically.
# Real environment variables take priority over this file.
ANTHROPIC_API_KEY=
# ONCALL_MODEL=claude-opus-5-5
# ONCALL_EFFORT=high
# ONCALL_REVIEWER=off                               # on: skeptical second opinion before approval (can only lower confidence)
# ONCALL_REVIEWER_TIMEOUT_S=30
# ONCALL_PROVIDER=anthropic                         # or gemini or groq
# GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# ONCALL_FALLBACK_PROVIDER=ollama                   # used only when the main provider fails
# OLLAMA_MODEL=qwen3:8b                             # must support tool calling
# OLLAMA_URL=http://127.0.0.1:11434/v1
# ONCALL_FALLBACKS=1            # set 0 if the organisers' key/proxy rejects the fallback beta

# Endpoints
# PROMETHEUS_URL=http://localhost:9090
# JAEGER_URL=http://localhost:8080/jaeger/ui/api   # or http://localhost:<docker compose port jaeger 16686>/api
# COMPOSE_PROJECT=opentelemetry-demo                # limit docker listing to the demo
# Our own Action API (python -m actionapi): the agent calls it only over HTTP
# ACTION_API_URL=http://127.0.0.1:8099
# ACTION_API_TOKEN=                                  # shared secret, required by the API on every call
# ACTION_API_PORT=8099
# ACTION_API_COOLDOWN_S=60
# ACTION_API_STATE=runs/action_api_state.json      # throttle/idempotency state, survives restarts
# LOCUST_URL=http://localhost:8080/loadgen           # Locust's own web API, via the demo's proxy
# ONCALL_THROTTLE_USERS=2
# VERIFY_FAST_PATH=1                                 # container + Jaeger spans: early "recovering"
# VERIFY_TIMEOUT_S=420                               # see oncall/config.py for all VERIFY_* tolerances
# ONCALL_ALLOW_FLAG_TOGGLE=0                         # 1 only after mentors confirm the rules
# ONCALL_FLAG_NAMES=                                 # names from allowed sources only, never flagd

# Email escalation (oncall/notify.py). Off by default. A real SMTP server sends incident data off
# this laptop; for local tests use a fake one (see README, Email escalation):
#   python -m aiosmtpd -n -l 127.0.0.1:1025   then   EMAIL_ENABLED=on  SMTP_HOST=127.0.0.1
#   SMTP_PORT=1025  SMTP_STARTTLS=off  (use 127.0.0.1, not localhost: Windows tries IPv6 ::1 first)
# Check the settings without running the agent: python -m oncall emailtest
EMAIL_ENABLED=off
EMAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=
EMAIL_FROM=
EMAIL_TO=
# Resend (EMAIL_TRANSPORT=resend): sends through Resend's servers, off this laptop. Its shared
# sender onboarding@resend.dev only delivers to the Resend account owner's own address until a
# domain is verified in Resend.
RESEND_API_KEY=
# Voice calls through Twilio (off by default). Test with: python -m oncall calltest
CALLS_ENABLED=off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ONCALL_PRIMARY_PHONE=
# Slack alerts through an incoming webhook (off by default). Test with: python -m oncall slacktest
SLACK_ENABLED=off
SLACK_WEBHOOK_URL=
# Approve fixes from the dashboard as well as the terminal (off by default).
UI_APPROVALS=off
APPROVAL_TIMEOUT_S=1800
# The dashboard's Tailscale name, for example poppy.your-tailnet.ts.net
UI_ALLOWED_HOSTS=
# Telegram alerts through a bot (off by default). Test with: python -m oncall telegramtest
TELEGRAM_ENABLED=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Our teammate's names also work: NOTIFICATION_FROM_EMAIL (= EMAIL_FROM), ONCALL_PRIMARY_EMAIL
# (added to EMAIL_TO), SMTP_PASS (= SMTP_PASSWORD); ONCALL_PRIMARY_NAME is used in the greeting.
NOTIFICATION_FROM_EMAIL=
ONCALL_PRIMARY_EMAIL=
ONCALL_PRIMARY_NAME=
SMTP_PASS=
# EMAIL_TIMEOUT_S=10                                 # per send; the agent never waits longer
# EMAIL_ON_RECOVERED=off                             # on: short info email when a run recovers
# EMAIL_ON_APPROVAL=on                               # page when a step waits for approval in the terminal

# Replay a recorded live run (fixture/test mode is NOT selectable here: use the --test flag)
# ONCALL_SOURCE=bundle
# ONCALL_BUNDLE_DIR=bundles/current

# Span-metric label names, if discovery shows different ones
# ONCALL_SERVICE_LABEL=service_name
# ONCALL_STATUS_LABEL=status_code
